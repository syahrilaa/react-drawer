{
  "name": "@syahakato/react-drawer",
  "version": "0.1.0",
  "private": false,
  "author": "Syahril Akbar Atthoriq <syahrilakbaraa@gmail.com>",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "bun run check-types && vite build",
    "check-types": "tsc --noEmit",
    "format": "biome format --write .",
    "lint": "biome check --write .",
    "check": "biome check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@microsoft/api-extractor": "^7.60.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">24"
  },
  "packageManager": "bun@1.4.4",
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0"
  }
}
