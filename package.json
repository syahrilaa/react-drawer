{
  "name": "@syahakato/react-drawer",
  "version": "0.1.0",
  "private": false,
  "author": "Syahril Akbar Atthoriq <syahrilakbaraa@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syahrilaa/react-drawer.git"
  },
  "homepage": "https://github.com/syahrilaa/react-drawer#readme",
  "bugs": {
    "url": "https://github.com/syahrilaa/react-drawer/issues"
  },
  "keywords": [
    "react",
    "drawer",
    "bottom-sheet",
    "dialog",
    "typescript",
    "accessible"
  ],
  "files": [
    "dist",
    "README.md",
    "README.id.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --noEmit && vite build --mode library",
    "check-types": "tsc --noEmit",
    "format": "biome format --write .",
    "lint": "biome check --write .",
    "check": "biome check .",
    "prepack": "npm run build",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@microsoft/api-extractor": "^7.60.1",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.4.4",
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0"
  }
}
